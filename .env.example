# Copy this file to .env (which is gitignored) and fill in real values.
# docker-compose reads .env automatically.

# Password for the Dockerized Postgres instance and the backend's connection to it.
POSTGRES_PASSWORD=postgres

# Jooble API key - see backend/src/main/java/com/canik/jmi/ingestion/source/JoobleJobSourceAdapter.java
# for how it's used. Leave blank to skip Jooble imports; the rest of the app works fine without it.
JOOBLE_API_KEY=
